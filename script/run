#!/bin/sh
# script/run: build and launch the app.
#
#   script/run              macOS
#   script/run ios          iOS Simulator (first booted one, else iPhone 17 Pro)
#   script/run ios "iPad Pro 11-inch (M5)"   a named simulator
#
# Physical devices need signing, so run those from Xcode (see README).

set -e

cd "$(dirname "$0")/.."

BUNDLE_ID="engineering.xo.Outbox"

case "${1:-macos}" in
  macos)
    script/build macos
    APP_PATH=$(xcodebuild -project Outbox.xcodeproj -scheme Outbox \
      -destination "platform=macOS" -showBuildSettings build 2>/dev/null |
      awk -F' = ' '/ BUILT_PRODUCTS_DIR/ {print $2; exit}')
    open "$APP_PATH/Outbox.app"
    ;;
  ios)
    script/generate

    # Our deployment target is 26.5, so older runtimes can't run the app.
    WANTED="${2:-iPhone 17 Pro}"
    UDID=$(xcrun simctl list devices available -j |
      python3 -c "
import json, sys
name = sys.argv[1]
data = json.load(sys.stdin)['devices']
for runtime, devices in data.items():
    if 'iOS-26' not in runtime:
        continue
    for device in devices:
        if device['name'] == name:
            print(device['udid'])
            raise SystemExit
" "$WANTED")

    if [ -z "$UDID" ]; then
      echo "No iOS 26 simulator named \"$WANTED\". Available:" >&2
      xcrun simctl list devices available -j |
        python3 -c "
import json, sys
for runtime, devices in json.load(sys.stdin)['devices'].items():
    if 'iOS-26' in runtime:
        for device in devices:
            print(' ', device['name'])
" >&2
      exit 1
    fi

    xcrun simctl boot "$UDID" 2>/dev/null || true
    open -a Simulator

    xcodebuild -project Outbox.xcodeproj -scheme Outbox \
      -destination "id=$UDID" CODE_SIGNING_ALLOWED=NO build

    APP_PATH=$(xcodebuild -project Outbox.xcodeproj -scheme Outbox \
      -destination "id=$UDID" -showBuildSettings build 2>/dev/null |
      awk -F' = ' '/ BUILT_PRODUCTS_DIR/ {print $2; exit}')/Outbox.app

    xcrun simctl install "$UDID" "$APP_PATH"
    xcrun simctl launch "$UDID" "$BUNDLE_ID"
    ;;
  *)
    echo "Usage: script/run [macos|ios] [simulator name]" >&2
    exit 1
    ;;
esac
